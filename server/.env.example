PORT=5000
NODE_ENV=production
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production

# =============================================================================
# 1. MONGODB ATLAS (Cloud Database)
# =============================================================================
# Optional: If not provided, TripNest automatically runs in persistent local JSON mode!
# Get your free MongoDB Atlas URI from https://cloud.mongodb.com:
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/tripnest?retryWrites=true&w=majority
MONGODB_URI=

# =============================================================================
# 2. CLOUDINARY (Cloud Storage for Ticket PDFs, Images & Trip Covers)
# =============================================================================
# Optional: If not provided, files & ticket images are safely stored inline!
# Get free credentials from https://cloudinary.com:
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# =============================================================================
# 3. GOOGLE GEMINI AI (Smart Document & Ticket Extraction)
# =============================================================================
# Get your free API key from https://aistudio.google.com/app/apikey:
GEMINI_API_KEY=

